APP_ORIGIN=http://localhost:3000
# Leave empty for a local, single-process JSON demo. Required on Vercel.
MONGODB_URI=
MONGODB_DB=ovia
# At least 32 characters. Required for accounts in production.
JWT_SECRET=
# Demo checkout is enabled only locally unless explicitly set to true.
ALLOW_DEMO_CHECKOUT=false
PAYMENT_PROVIDER=demo
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Real payments stay disabled until verified business configuration exists.
COMMERCE_ENABLED=false
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CRON_SECRET=
EMAIL_API_KEY=
EMAIL_FROM=

# Optional recipient explicitly designated by the owner for manual real-email verification.
# This is not used as a signup default or sent to the browser.
AUTH_TEST_EMAIL=
