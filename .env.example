APP_ORIGIN=http://localhost:3000
# Leave empty for a local, single-process JSON demo. Required on Vercel.
MONGODB_URI=
MONGODB_DB=ovia
# At least 32 characters. Required for accounts in production.
JWT_SECRET=
# Demo checkout is enabled only locally unless explicitly set to true.
ALLOW_DEMO_CHECKOUT=false
PAYMENT_PROVIDER=demo
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Separate webhook signing secret configured in the Razorpay dashboard.
# Set PAYMENT_PROVIDER=razorpay to use these server-only keys. Live requires MongoDB.
RAZORPAY_WEBHOOK_SECRET=
# Real payments stay disabled until verified business configuration exists.
COMMERCE_ENABLED=false
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CRON_SECRET=
EMAIL_API_KEY=
EMAIL_FROM=

# Optional recipient explicitly designated by the owner for manual real-email verification.
# This is not used as a signup default or sent to the browser.
AUTH_TEST_EMAIL=

# PayPal sandbox only. Never prefix secrets with NEXT_PUBLIC_.
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
# The catalog uses INR; PayPal does not support INR settlement.
PAYPAL_CURRENCY=USD
# Required merchant-approved INR per one settlement-currency unit. No implicit rate.
PAYPAL_INR_PER_UNIT=
CHECKOUT_STANDARD_SHIPPING_PAISE=0
CHECKOUT_EXPRESS_ENABLED=false
CHECKOUT_EXPRESS_SHIPPING_PAISE=49900
# Set the applicable merchant tax rate in basis points (1800 = 18%).
CHECKOUT_TAX_BPS=0
CHECKOUT_TAX_INCLUSIVE=true
# Optional social sign-in: server-only credentials; never use NEXT_PUBLIC_.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
# PKCS8 .p8 key; quoted multiline value or literal \n separators.
APPLE_PRIVATE_KEY=

# Delhivery Logistics configuration (Server-side only; never prefix with NEXT_PUBLIC_)
DELHIVERY_ENV=production
DELHIVERY_API_TOKEN=
DELHIVERY_PICKUP_LOCATION=OVIA Warehouse Central
DELHIVERY_WEBHOOK_SECRET=


# Google Cloud Translation Basic API key (server only)
GOOGLE_TRANSLATE_API_KEY=

# DeepL API key (server only); :fx keys use the Free endpoint
DEEPL_API_KEY=

# Company email import (read-only Gmail OAuth, separate from customer Google sign-in)
SUPPORT_INBOX_EMAIL=shuklaadarshcs232447@gmail.com
SUPPORT_GMAIL_CLIENT_ID=
SUPPORT_GMAIL_CLIENT_SECRET=
SUPPORT_GMAIL_REFRESH_TOKEN=
# Optional authenticated server-to-server forwarding bridge
SUPPORT_INBOUND_SECRET=

# Full support: receiving Gmail mailbox and persistent Socket.IO worker
SUPPORT_REPLY_TO=adarshshukla4639@gmail.com
# Local default is http://localhost:3001; production needs a persistent HTTPS worker.
SUPPORT_REALTIME_URL=
SUPPORT_REALTIME_PORT=3001
